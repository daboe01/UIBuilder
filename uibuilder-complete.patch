+{
+    self = [super initWithFrame:aRect];
+    if (self)
+        [self setFrameSize:CGSizeMake(120, 64)];
+    return self;
+}
+
+- (CGSize)intrinsicContentSize
+{
+    return CGSizeMake(120, 64);
+}
+
